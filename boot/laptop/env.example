# /etc/voidos/env — voidOS machine configuration (chmod 600)
# Set your model key, then reboot.

OLLAMA_API_KEY=
VOID_MODEL=gpt-oss:120b
# Or point at a LOCAL ollama to run fully offline (no key needed):
# OLLAMA_HOST=http://127.0.0.1:11434

VOID_ROOT=/var/lib/voidos
VOID_SOCK=/var/lib/voidos/.void/void.sock
VOID_POLICY=guarded
VOID_UI_HOST=127.0.0.1
VOID_UI_PORT=7777
